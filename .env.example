# ================================================
#  Model Provider Configuration
# ================================================
# Choose your model providers in config.yaml (models section).
# Only set the API keys for the providers you plan to use.

# OpenAI API Key (required if using provider: "openai" for chat or embedding)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek API Key (required if using provider: "deepseek" for chat)
# Get your key from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Cohere API Key (Optional - for Cohere cloud reranker)
# Get your key from: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_api_key_here
